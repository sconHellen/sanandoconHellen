# Copy to .env.local for local development. Real values live only in Vercel
# environment variables (Development / Preview / Production). Never commit secrets.

DATABASE_URL=
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_TOKEN=
HOTMART_WEBHOOK_HOTTOK=
HOTMART_ENV=sandbox            # sandbox | production
EMAIL_API_KEY=
EMAIL_FROM=
VIDEO_PROVIDER=r2             # r2 | local (local = files in media-out/, development only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sch-media
R2_JURISDICTION=               # empty for standard buckets; "eu" if the bucket has the EU jurisdiction
# MEDIA_LOCAL_DIR=media-out    # only for VIDEO_PROVIDER=local
SESSION_SECRET=
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=
APP_URL=
